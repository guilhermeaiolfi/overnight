				  paths\?\: \?array\<string, string\>,
				  prod_envs\?\: \?string\[\],
				  dotenv_path\?\: \?string,
				  test_envs\?\: \?string\[\],
				  use_putenv\?\: \?bool,
				  runtimes\?\: \?array,
				  error_handler\?\: string\|false,
